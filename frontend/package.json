{
  "name": "mirai-role-portals",
  "private": true,
  "description": "Five role portals for the Mirai Club Activities Tracker (vanilla JS, no bundler).",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build-portal.mjs",
    "serve": "node scripts/serve.mjs --all",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:karma": "node scripts/run-karma.mjs",
    "capture-fixtures": "node scripts/capture-fixtures.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "jasmine-core": "^7.0.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "^5.1.0"
  }
}
